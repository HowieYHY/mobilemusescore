{
  "id": "./",
  "name": "PocketScore",
  "short_name": "PocketScore",
  "description": "View and play MuseScore (.mscz) scores offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e9ecef",
  "theme_color": "#1e2a3a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-musescore": [".mscz"] } }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "score", "accept": [".mscz", "application/x-musescore", "application/vnd.musescore", "application/zip", "application/octet-stream"] }
      ]
    }
  }
}
